{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-ai-game-lab",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smart-ai-game-lab",
      "database_id": "bad4186e-7f7d-4408-98cc-0591337cf836",
      "migrations_dir": "migrations"
    }
  ]
}
