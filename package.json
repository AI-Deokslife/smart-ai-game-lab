{
  "name": "smart-ai-game-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply smart-ai-game-lab --local",
    "db:remote": "wrangler d1 migrations apply smart-ai-game-lab --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
